{
  "name": "course-management",
  "version": "1.0.0",
  "private": true,
  "description": "Course Management REST API built with Node.js, Express, TypeScript, Prisma 7, and PostgreSQL",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
